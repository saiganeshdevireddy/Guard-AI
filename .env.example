# Example values for backend environment variables.
# This file is a reference only; the backend does not load .env files automatically.
# GUARD_AI_DATABASE_URL=sqlite:///C:/path/to/guard_ai.db
# Development origins only. For deployment, set exact HTTPS frontend origins;
# never use '*'.
GUARD_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
GUARD_AI_MAX_UPLOAD_BYTES=10485760
GUARD_AI_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
GUARD_AI_BLOCKCHAIN_CONTRACT_ADDRESS=
# Authentication must be configured before protected endpoints can be used.
# Generate a signing secret out of band (at least 32 random bytes); never commit it.
# GUARD_AI_AUTH_TOKEN_SECRET=<random secret, 32+ bytes>
GUARD_AI_AUTH_TOKEN_TTL_SECONDS=900
# Provision Argon2id user hashes interactively with:
# python -m app.security.auth --provision-user
# Store the resulting JSON entry in GUARD_AI_AUTH_USERS (secret environment variable).
# GUARD_AI_AUTH_USERS=[{"username":"operator","password_hash":"$argon2id$...","role":"operator","active":true}]
