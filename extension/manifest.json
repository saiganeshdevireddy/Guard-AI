{
  "manifest_version": 3,
  "name": "Guard AI Link Protection",
  "version": "1.0.0",
  "description": "Checks clicked links with the local Guard AI pipeline.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
