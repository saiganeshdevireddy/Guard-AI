# Frontend build-time settings. These values are public in the compiled bundle.
# Supply only non-secret configuration here; never place credentials or keys in VITE_* variables.
# In development, leave the API URL unset to use vite.config.js's /api -> 127.0.0.1:8000 proxy.
# In production, use the HTTPS origin of the separately hosted FastAPI service.
VITE_API_BASE_URL=https://api.example.com
VITE_API_TIMEOUT_MS=12000
